# Environment template. PLACEHOLDERS ONLY. Never put real values in this file.
# Copy to .env.local (git-ignored) and fill in values for your environment.
# See docs/setup/ENVIRONMENTS.md.

# --- Public (inlined into the browser bundle at build time) ---------------
# Supabase API URL. Local stack default: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase PUBLISHABLE key (sb_publishable_...) or legacy anon key.
# This key is protected by Row Level Security. NEVER put a secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# --- Server only (never prefix with NEXT_PUBLIC_) ---------------------------
# development | test | staging | production
APP_ENV=development
# Public base URL of this app (used in auth email links)
APP_BASE_URL=http://localhost:3000
# debug | info | warn | error
LOG_LEVEL=info

# PRIVILEGED: bypasses Row Level Security. Server runtime only.
# Leave empty unless a server-side admin task needs it.
SUPABASE_SECRET_KEY=

# Server/CLI only: Postgres connection string for applying migrations (dev/staging).
# Never used by the running app. Keep out of client code and Git.
SUPABASE_DB_URL=
